# Normalise line endings in the repository; check files out with the right ones per platform.
* text=auto

# Windows scripts need CRLF (cmd.exe misreads LF-only batch files); shell scripts must stay LF,
# or bash fails on Linux and Colab with "$'\r': command not found".
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.sh     text eol=lf

# Left out of source archives (GitHub zips of a branch or release tag, updates): notes for developers, research
# scripts, the promo-video project and sample footage. A git clone (Colab) still has them.
/CLAUDE.md      export-ignore
/docs/PLAN.md   export-ignore
/spikes         export-ignore
/videos         export-ignore
/samples        export-ignore
/PRODUCT.md     export-ignore
/DESIGN.md      export-ignore
/.impeccable    export-ignore

# Notebooks are JSON text
*.ipynb  text

# Images and video
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.tif    binary
*.tiff   binary
*.webp   binary
*.ico    binary
